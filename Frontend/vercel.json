{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://misstech-backend.vercel.app/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://misstech-backend.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
